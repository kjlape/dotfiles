#!/bin/sh
# Builds the Flatpak from this checkout, installs it for this user, and
# writes a single-file bundle (<name>.flatpak) that installs on any Linux
# with Flatpak.
set -eu
. "$(dirname -- "$0")/lib.sh"

# The builder runs in its own sandbox with a private /tmp, so a checkout
# there is invisible to it and the build fails with a confusing path.
case "$ROOT" in /tmp/* | /var/tmp/*) die "build from a checkout under your home directory, not $ROOT." ;; esac

setup_builder
cd "$ROOT/flatpak"
$BUILDER --user --force-clean --repo=repo --install \
  --state-dir="${APP_STATE_DIR:-$ROOT/.flatpak-builder}" build-dir "$APP.yml"

# When someone installs the bundle, Flatpak pulls the runtime from Flathub.
flatpak build-bundle --runtime-repo=https://dl.flathub.org/repo/flathub.flatpakrepo \
  repo "$ROOT/$NAME.flatpak" "$APP"

echo "Installed $APP for $(id -un) and wrote $ROOT/$NAME.flatpak"
