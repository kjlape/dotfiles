#!/bin/sh
# Publishes the app as a signed Flatpak repository on GitHub Pages, so anyone
# can install it with one command and get new releases with flatpak update.
#
#   bin/flatpak-repo            Build the checked-out release and add it to
#                               build/pages, a checkout of the gh-pages branch.
#                               Nothing leaves the machine.
#   bin/flatpak-repo --publish  Also push gh-pages and turn on GitHub Pages.
#
# APP_GPG_KEY names the GPG key that signs the repository (see
# docs/PUBLISHING.md). Run it on a commit tagged by bin/release.
set -eu
. "$(dirname -- "$0")/lib.sh"

PUBLISH=0
case "${1:-}" in
  "") ;;
  --publish) PUBLISH=1 ;;
  *) sed -n '2,/^[^#]/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'; exit 1 ;;
esac

KEY="${APP_GPG_KEY:-}"
[ -n "$KEY" ] || die "set APP_GPG_KEY to the signing key's ID. See docs/PUBLISHING.md, \"Make a signing key\"."
gpg --list-secret-keys "$KEY" >/dev/null 2>&1 || die "gpg has no secret key $KEY."
need ostree "Install it from your distribution's packages."
cd "$ROOT"
TAG="$(git describe --tags --exact-match --match 'v*' HEAD 2>/dev/null)" \
  || die "this commit isn't a release. Make one with bin/release, or check out its tag."
[ -z "$(git status --porcelain)" ] || die "commit or stash your changes first."

# build/pages holds the gh-pages branch, which carries the whole repository:
# it starts from what's published, so every earlier release stays installable.
PAGES="$ROOT/build/pages"
has_remote_pages() {
  git remote get-url origin >/dev/null 2>&1 && git ls-remote --exit-code origin refs/heads/gh-pages >/dev/null 2>&1
}
# Bookkeeping on this branch uses commands that run no git hooks, so a
# broken global hook can't stop a publish halfway.
if [ ! -e "$PAGES/.git" ]; then
  git worktree prune
  if has_remote_pages; then
    git fetch -q origin "+gh-pages:refs/remotes/origin/gh-pages"
    git worktree add -q --no-checkout -B gh-pages "$PAGES" origin/gh-pages
    git -C "$PAGES" reset -q --hard
  else
    git worktree add -q --orphan -b gh-pages "$PAGES"
  fi
fi
git -C "$PAGES" symbolic-ref HEAD refs/heads/gh-pages
if has_remote_pages; then
  git -C "$PAGES" fetch -q origin gh-pages
  git -C "$PAGES" reset -q --hard FETCH_HEAD
fi

"$ROOT/bin/flatpak"

REPO="$PAGES/repo"
[ -d "$REPO/objects" ] || ostree --repo="$REPO" init --mode=archive-z2
# Git keeps no empty directories, so a repository restored from gh-pages
# lacks the ones OSTree expects; its lock and scratch space stay out of git.
for directory in refs/heads refs/remotes refs/mirrors tmp state extensions; do
  mkdir -p "$REPO/$directory"
done
printf '/repo/.lock\n/repo/tmp/\n/repo/state/\n' >"$PAGES/.gitignore"
REF="$(ostree --repo="$ROOT/flatpak/repo" refs | grep "^app/$APP/" | head -1)"
[ -n "$REF" ] || die "the build made no app/$APP ref."
flatpak build-commit-from --src-repo="$ROOT/flatpak/repo" --gpg-sign="$KEY" \
  --subject="$TITLE ${TAG#v}" "$REPO" "$REF"
# Deltas make updates small; pruning keeps the last few releases so the
# branch stays a reasonable size.
flatpak build-update-repo --title="$TITLE" --comment="$SUMMARY" \
  --homepage="https://github.com/$GITHUB_REPO" --icon="$PAGES_URL/$NAME.svg" \
  --gpg-sign="$KEY" --generate-static-deltas --prune --prune-depth=3 "$REPO"

KEY_BASE64="$(gpg --export "$KEY" | base64 -w0)"
gpg --export --armor "$KEY" >"$PAGES/$NAME.gpg"
cp "$ROOT/pkgbuild/$NAME.svg" "$PAGES/$NAME.svg"
# GitHub Pages would otherwise run Jekyll over the repository's files.
touch "$PAGES/.nojekyll"
BRANCH="${REF##*/}"

cat >"$PAGES/$NAME.flatpakrepo" <<EOF
[Flatpak Repo]
Title=$TITLE
Url=$PAGES_URL/repo/
Homepage=https://github.com/$GITHUB_REPO
Comment=$SUMMARY
Icon=$PAGES_URL/$NAME.svg
GPGKey=$KEY_BASE64
EOF

cat >"$PAGES/$APP.flatpakref" <<EOF
[Flatpak Ref]
Title=$TITLE
Name=$APP
Branch=$BRANCH
Url=$PAGES_URL/repo/
SuggestRemoteName=$NAME
Homepage=https://github.com/$GITHUB_REPO
Icon=$PAGES_URL/$NAME.svg
RuntimeRepo=https://dl.flathub.org/repo/flathub.flatpakrepo
IsRuntime=false
GPGKey=$KEY_BASE64
EOF

cat >"$PAGES/index.html" <<EOF
<!doctype html>
<html lang="en">
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>$TITLE</title>
<style>
  body { font: 16px/1.5 system-ui, sans-serif; max-width: 42rem; margin: 3rem auto; padding: 0 1rem; color: #1a1a1a; background: #fff; }
  pre { background: #f2f2f2; padding: .75rem 1rem; overflow-x: auto; }
  img { width: 64px; height: 64px; }
  @media (prefers-color-scheme: dark) { body { color: #e6e6e6; background: #0e0e10; } pre { background: #1c1c20; } a { color: #ffd60a; } }
</style>
<img src="$NAME.svg" alt="">
<h1>$TITLE</h1>
<p>$SUMMARY. Version ${TAG#v}.</p>
<h2>Install</h2>
<pre>flatpak install --user $PAGES_URL/$APP.flatpakref</pre>
<p>Then run it from your app launcher, or with <code>flatpak run $APP</code>.
Updates arrive with <code>flatpak update</code>.</p>
<p>The repository is signed with <a href="$NAME.gpg">this key</a>.
Source and releases are on <a href="https://github.com/$GITHUB_REPO">GitHub</a>.</p>
</html>
EOF

# One parentless commit holding the current repository; its history lives
# in OSTree, so the branch doesn't need its own.
git -C "$PAGES" add -A
tree="$(git -C "$PAGES" write-tree)"
commit="$(git -C "$PAGES" commit-tree "$tree" -m "Publish $TITLE $TAG")"
git -C "$PAGES" update-ref refs/heads/gh-pages "$commit"
echo "Added $TAG to $REPO."

if [ "$PUBLISH" = 0 ]; then
  echo "Nothing was pushed. Publish with: bin/flatpak-repo --publish"
  exit 0
fi

need gh "Install github-cli and run: gh auth login"
git remote get-url origin >/dev/null 2>&1 \
  || die "there's no origin remote. See docs/PUBLISHING.md, \"Create the GitHub repository\"."
confirm "Replace the gh-pages branch on origin with the repository holding $TAG, and serve it on GitHub Pages?"
git -C "$PAGES" push -q --force origin gh-pages
if ! gh api "repos/$GITHUB_REPO/pages" >/dev/null 2>&1; then
  gh api -X POST "repos/$GITHUB_REPO/pages" -f "source[branch]=gh-pages" -f "source[path]=/" >/dev/null
  echo "Turned on GitHub Pages; the first deploy takes a minute or two."
fi
echo "Published. Anyone can install $TITLE with:"
echo "  flatpak install --user $PAGES_URL/$APP.flatpakref"
