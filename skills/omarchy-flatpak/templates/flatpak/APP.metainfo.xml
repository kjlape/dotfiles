<?xml version="1.0" encoding="UTF-8"?>
<!-- Save as flatpak/<app-id>.metainfo.xml, and check it with appstreamcli
     validate and its no-net flag. (XML comments can't hold two hyphens.) -->
<component type="desktop-application">
  <id>io.github.<owner>.<Name></id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name><Name></name>
  <summary><one-line summary, no trailing period></summary>
  <developer id="io.github.<owner>">
    <name><Your Name></name>
  </developer>
  <description>
    <p>What it does, in a sentence or two, for someone who's never seen it.</p>
    <ul>
      <li>One feature per item</li>
      <li>Driven from the keyboard; press ? for every shortcut</li>
    </ul>
  </description>
  <launchable type="desktop-id">io.github.<owner>.<Name>.desktop</launchable>
  <provides>
    <binary><name></binary>
  </provides>
  <url type="homepage">https://github.com/<owner>/<name></url>
  <url type="bugtracker">https://github.com/<owner>/<name>/issues</url>
  <url type="vcs-browser">https://github.com/<owner>/<name></url>
  <screenshots>
    <screenshot type="default">
      <caption>What the screenshot shows</caption>
      <!-- bin/release-flatpak points this at each release's tag. -->
      <image>https://raw.githubusercontent.com/<owner>/<name>/v0.1.0/docs/screenshot.png</image>
    </screenshot>
  </screenshots>
  <categories>
    <category>Utility</category>
  </categories>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>
  <branding>
    <color type="primary" scheme_preference="light">#ffd60a</color>
    <color type="primary" scheme_preference="dark">#7a6500</color>
  </branding>
  <content_rating type="oars-1.1"/>
  <!-- Left empty: bin/release-flatpak adds each release's entry in its own
       checkout of the tag, from the commit subjects since the last one. -->
  <releases>
  </releases>
</component>
