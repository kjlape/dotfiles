#!/usr/bin/env bash
# gdr: git diff review. Usage: gdr [base] [feature] | gdr setup
pref_file=$(git rev-parse --git-dir 2>/dev/null)/code-review-base
pref=$([[ -f $pref_file ]] && head -n1 "$pref_file")
base=${1:-${pref:-master}}
feature=${2:-HEAD}

if [[ $1 == setup ]]; then
  default=${pref:-$(git symbolic-ref --short HEAD 2>/dev/null || echo master)}
  printf 'Base branch for git-code-review%s: ' " [$default]" >&2
  read -r answer
  base=${answer:-$default}
  printf '%s\n' "$base" > "$pref_file"
  echo "Saved base branch '$base' to $pref_file" >&2
  exit 0
fi

range="$base...$feature"

git diff --numstat "$range" |
  fzf --disabled --reverse --no-sort --delimiter=$'\t' \
      --header "$range   j/k move · g/G top/bottom · / filter · ctrl-l clear · enter open · y copy path · ctrl-d/u scroll preview · q quit" \
      --preview "git diff --color=always $range -- {3} | delta --paging=never" \
      --preview-window=right,70% \
      --bind 'j:down,k:up,g:first,G:last,q:abort' \
      --bind '/:enable-search+unbind(j,k,g,G,q)' \
      --bind 'esc:disable-search+rebind(j,k,g,G,q)' \
      --bind 'ctrl-l:clear-query' \
      --bind 'y:execute-silent(printf %s {3} | uni-copy)' \
      --bind 'ctrl-d:preview-half-page-down,ctrl-u:preview-half-page-up' \
      --bind "enter:execute(git diff --color=always $range -- {3} | delta --paging=always)"
