#!/usr/bin/env ruby

# Rewrites every KEY_PORT=<number> line of an env file so the port doesn't
# collide with anything else, printing the result to stdout.
#
# Usage: uniqify-env-ports [--slot N [--stride S]] [--reserve PORT[,PORT...]] [FILE]
#
# By default each port is probed: it's kept if free, otherwise a nearby free
# port is picked. Probing only sees what's listening right now, so two env
# files uniqified while neither service is running can get the same ports.
#
# With --slot, every port is offset by N * stride (stride defaults to 100)
# instead, so callers that hand out distinct slots get non-overlapping ports
# whether or not anything is running. If any offset port is reserved, out of
# range or already bound, nothing is printed and the exit status is 2; try
# another slot.
#
# Ports given to --reserve are treated as taken. Keys sharing a port are
# assumed to name the same service and keep sharing it.

require 'optparse'
require 'set'
require 'socket'

PORT_RANGE = 1024..65535
SLOT_UNAVAILABLE = 2

class EnvironmentFile
  PORT_LINE = /\A(?<prefix>\s*(?:export\s+)?)(?<key>[A-Za-z0-9_]*_PORT)\s*=\s*(?<port>\d+)\s*\z/

  def initialize(path)
    abort "File not found: #{path}" unless File.exist?(path)

    @lines = File.read(path).lines.map(&:chomp)
  end

  # Every in-range port in the file, mapped to the keys that use it
  def ports
    @lines.each_with_object(Hash.new { |h, k| h[k] = [] }) do |line, ports|
      match = PORT_LINE.match(line) or next
      port = match[:port].to_i
      ports[port] << match[:key] if PORT_RANGE.cover?(port)
    end
  end

  def render(resolved_ports)
    @lines.map do |line|
      match = PORT_LINE.match(line)
      new_port = match && resolved_ports[match[:port].to_i]
      new_port ? "#{match[:prefix]}#{match[:key]}=#{new_port}\n" : "#{line}\n"
    end.join
  end
end

class PortChecker
  def initialize(reserved_ports)
    @reserved_ports = reserved_ports.to_set
  end

  # Binding both loopback and the wildcard address catches listeners on any
  # interface, including platforms where one doesn't block the other.
  def available?(port)
    PORT_RANGE.cover?(port) &&
      !@reserved_ports.include?(port) &&
      %w[127.0.0.1 0.0.0.0].all? { |host| bindable?(host, port) }
  end

  def reserve(port)
    @reserved_ports << port
  end

  private

  def bindable?(host, port)
    TCPServer.new(host, port).close
    true
  rescue Errno::EADDRINUSE, Errno::EACCES
    false
  end
end

def probe(base_port, checker)
  nearby = (1..100).flat_map do |offset|
    [(base_port / 100 + offset) * 100 + base_port % 100, base_port + offset, base_port - offset]
  end

  ([base_port] + nearby).find { |port| checker.available?(port) } ||
    PORT_RANGE.find { |port| checker.available?(port) } ||
    abort("Could not find an available port for #{base_port}")
end

def main
  slot = nil
  stride = 100
  reserved_ports = []

  OptionParser.new do |opts|
    opts.banner = "Usage: #{File.basename($PROGRAM_NAME)} [--slot N [--stride S]] [--reserve PORT[,PORT...]] [FILE]"
    opts.on('--slot N', Integer, 'Offset every port by N * stride') { |n| slot = n }
    opts.on('--stride S', Integer, 'Distance between slots (default 100)') { |s| stride = s }
    opts.on('--reserve PORTS', Array, 'Ports to treat as taken; repeatable') do |ports|
      reserved_ports.concat(ports.reject(&:empty?).map { |port| Integer(port) })
    end
  end.parse!

  env_file = EnvironmentFile.new(ARGV[0] || '.env')
  checker = PortChecker.new(reserved_ports)
  resolved_ports = {}

  if slot
    conflicts = env_file.ports.filter_map do |base_port, keys|
      port = base_port + slot * stride
      resolved_ports[base_port] = port
      "#{keys.join(', ')}: #{port}" unless checker.available?(port)
    end

    unless conflicts.empty?
      warn "Slot #{slot} unavailable (#{conflicts.join('; ')})"
      exit SLOT_UNAVAILABLE
    end
  else
    env_file.ports.each_key do |base_port|
      resolved_ports[base_port] = probe(base_port, checker)
      checker.reserve(resolved_ports[base_port])
    end
  end

  print env_file.render(resolved_ports)
end

main if __FILE__ == $PROGRAM_NAME
